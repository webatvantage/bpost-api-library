{
  "name": "webatvantage/bpost-api-library",
  "type": "library",
  "description": "Modern PHP 8.5 client for the full bpost API: Shipping Manager orders and labels, parcel announcement and tracking, and the Geolocator.",
  "keywords": [
    "bpost",
    "bpack",
    "shipping",
    "parcel",
    "tracking",
    "belgium",
    "api-client"
  ],
  "homepage": "https://github.com/webatvantage/bpost-api-library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Tom Six",
      "email": "tom@webatvantage.be",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/webatvantage/bpost-api-library/issues",
    "source": "https://github.com/webatvantage/bpost-api-library"
  },
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "composer/ca-bundle": "^1.5",
    "covergenius/guzzle_logger": "^2.3.1",
    "guzzlehttp/guzzle": "^7.8",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0.4",
    "phpstan/phpstan-phpunit": "^2.0.13",
    "phpunit/phpunit": "^13.3",
    "webatvantage/php-cs-fixer-config": "^1.4.0"
  },
  "suggest": {
    "ext-curl": "Lets Guzzle use the cURL handler, which is faster than the stream wrapper."
  },
  "repositories": [
    {
      "name": "covergenius/guzzle_logger",
      "type": "vcs",
      "url": "https://github.com/tomsix/guzzle-log-middleware.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "Webatvantage\\Bpost\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webatvantage\\Bpost\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit --display-phpunit-deprecations",
    "test-coverage": "vendor/bin/phpunit --coverage-html reports/coverage",
    "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
