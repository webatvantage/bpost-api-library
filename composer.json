{
  "name": "webatvantage/bpost-api-library",
  "type": "library",
  "description": "bpost API library is a PHP library to communicate with the bpost API.",
  "homepage": "https://github.com/webatvantage/bpost-api-library",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Raphaël Pommier",
      "email": "rpommier@antidot.com",
      "role": "Developer"
    },
    {
      "name": "kouinkouin",
      "email": "me@kouinkouin.com",
      "role": "Developer"
    },
    {
      "name": "Tijs Verkoyen",
      "email": "bpost@verkoyen.eu",
      "role": "Developer"
    },
    {
      "name": "Tom Six",
      "email": "tom@webatvantage.be",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-SimpleXML": "*",
    "ext-libxml": "*",
    "gmponos/guzzle_logger": "^2.2",
    "guzzlehttp/guzzle": "^7.8",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0.4",
    "phpstan/phpstan-phpunit": "^2.0.13",
    "phpunit/phpunit": "^11.5.50",
    "webatvantage/php-cs-fixer-config": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Webatvantage\\Bpost\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webatvantage\\Bpost\\Api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit --display-phpunit-deprecations",
    "test-coverage": "vendor/bin/phpunit --coverage-html reports/coverage",
    "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
